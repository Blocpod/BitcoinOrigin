{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Blocpod/BitcoinOrigin/schemas/evidence-report-v1.schema.json",
  "title": "ORIGIN Evidence Report v1",
  "type": "object",
  "required": ["schemaVersion", "subject", "checks", "contentHash"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "subject": {
      "type": "object",
      "required": ["name", "revision"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "layer", "status", "method", "artifacts"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "layer": {
            "enum": ["founding", "historical", "consensus", "relay-policy", "mining-policy", "wallet", "custody", "build-provenance", "governance"]
          },
          "status": { "enum": ["pass", "fail", "warn", "unknown"] },
          "method": { "type": "string", "minLength": 1 },
          "artifacts": { "type": "array" }
        },
        "additionalProperties": true
      }
    },
    "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": true
}
